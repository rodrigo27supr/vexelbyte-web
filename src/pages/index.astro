---
import LayoutBase from '../layouts/LayoutBase.astro';
import CarruselNoticias from '../components/contenido/CarruselNoticias.astro';
import TarjetaNoticia from '../components/contenido/TarjetaNoticia.astro';
import EsquemaJsonLd from '../components/seo/EsquemaJsonLd.astro';
import { obtenerArticulosPublicados } from '../lib/api-articulos';
import { CATEGORIAS, filtrarPorCategoria } from '../lib/categorias';
import { construirEsquemaOrganizacion } from '../lib/esquema-organizacion';

// Portada de revista: la ultima noticia en grande con una columna de las
// siguientes, y debajo un bloque por seccion. Una noticia de la cabecera no se
// repite en su bloque, para que la portada no ensene dos veces lo mismo.
const NOTICIAS_COLUMNA_LATERAL = 4;
// Los bloques alternan apertura con lista y carrusel: cuatro rejillas
// identicas seguidas hacian la portada monotona, y el carrusel deja ver mas
// noticias de la seccion sin alargar la pagina (en movil media 7.000 px).
const NOTICIAS_BLOQUE_CON_APERTURA = 4;
const NOTICIAS_BLOQUE_EN_CARRUSEL = 8;

const noticias = await obtenerArticulosPublicados();
const [noticiaDestacada, ...restoNoticias] = noticias;
const noticiasLaterales = restoNoticias.slice(0, NOTICIAS_COLUMNA_LATERAL);
const slugsEnCabecera = new Set([noticiaDestacada, ...noticiasLaterales].filter(Boolean).map((noticia) => noticia.slug));

const categoriasConNoticias = CATEGORIAS.map((categoria) => ({
  ...categoria,
  noticiasCategoria: filtrarPorCategoria(noticias, categoria.clave),
})).filter((categoria) => categoria.noticiasCategoria.length > 0);

const seccionesConBloque = categoriasConNoticias
  .map((categoria) => ({
    ...categoria,
    noticiasFueraDeCabecera: categoria.noticiasCategoria.filter((noticia) => !slugsEnCabecera.has(noticia.slug)),
  }))
  .filter((seccion) => seccion.noticiasFueraDeCabecera.length > 0)
  .map((seccion, posicionSeccion) => {
    const tieneApertura = posicionSeccion % 2 === 0;
    const [apertura, ...siguientes] = seccion.noticiasFueraDeCabecera.slice(
      0,
      tieneApertura ? NOTICIAS_BLOQUE_CON_APERTURA : NOTICIAS_BLOQUE_EN_CARRUSEL,
    );
    return { ...seccion, tieneApertura, apertura, siguientes };
  });

const esquemaJsonLd = construirEsquemaOrganizacion(Astro.site);
---

<LayoutBase titulo="Inicio" descripcion="Noticias y análisis de hardware de PC, smartphones, tablets y rendimiento en juegos.">
  <Fragment slot="head">
    <EsquemaJsonLd datos={esquemaJsonLd} />
  </Fragment>

  <section class="mx-auto max-w-portal px-4 pt-8 pb-8 sm:px-6 sm:pt-12">
    <h1 class="max-w-3xl text-2xl text-balance sm:text-4xl">Hardware de PC, móviles y rendimiento, con los datos por delante</h1>
  </section>

  {
    noticiaDestacada ? (
      <>
        <div class="mx-auto grid max-w-portal gap-10 px-4 sm:px-6 lg:grid-cols-12">
          <section aria-label="Noticia destacada" class="lg:col-span-8">
            <TarjetaNoticia articulo={noticiaDestacada} variante="destacada" nivelTitular={2} esPrioritaria />
          </section>
          {noticiasLaterales.length > 0 && (
            <aside aria-labelledby="titulo-lo-ultimo" class="lg:col-span-4">
              <h2 id="titulo-lo-ultimo" class="border-b border-borde-suave pb-3 text-xl">
                Lo último
              </h2>
              <ul role="list" class="flex flex-col divide-y divide-borde-suave">
                {noticiasLaterales.map((articulo) => (
                  <li class="py-4">
                    <TarjetaNoticia articulo={articulo} variante="lateral" />
                  </li>
                ))}
              </ul>
            </aside>
          )}
        </div>

        {/* Los bloques en carrusel van sobre una banda azul hielo a todo el
            ancho: alternar blanco y banda da ritmo a la portada al bajar. */}
        {seccionesConBloque.map((seccion) => (
          <section
            aria-labelledby={`titulo-seccion-${seccion.rutaSlug}`}
            class:list={['mt-16', !seccion.tieneApertura && 'bg-fondo-realzado py-12']}
          >
            <div class="mx-auto max-w-portal px-4 sm:px-6">
              <div
                class:list={[
                  'flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b pb-3',
                  seccion.tieneApertura ? 'border-borde-suave' : 'border-acento/15',
                ]}
              >
                <h2 id={`titulo-seccion-${seccion.rutaSlug}`} class="text-2xl">
                  {seccion.etiqueta}
                </h2>
                <a
                  href={`/categoria/${seccion.rutaSlug}/`}
                  class="inline-flex min-h-9 items-center text-sm font-semibold text-acento-texto underline-offset-4 hover:underline"
                >
                  Todo en {seccion.etiqueta}
                </a>
              </div>
              {seccion.tieneApertura ? (
                <div class="mt-6 grid gap-8 lg:grid-cols-12 lg:gap-10">
                  <div class="lg:col-span-7">
                    <TarjetaNoticia articulo={seccion.apertura} variante="destacada" mostrarCategoria={false} />
                  </div>
                  {seccion.siguientes.length > 0 && (
                    <ul role="list" class="flex flex-col divide-y divide-borde-suave lg:col-span-5">
                      {seccion.siguientes.map((articulo) => (
                        <li class="py-4 first:pt-0">
                          <TarjetaNoticia articulo={articulo} variante="lateral" mostrarCategoria={false} />
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ) : (
                <div class="mt-6">
                  <CarruselNoticias
                    noticias={[seccion.apertura, ...seccion.siguientes]}
                    etiquetaAccesible={`Noticias de ${seccion.etiqueta}`}
                    mostrarCategoria={false}
                  />
                </div>
              )}
            </div>
          </section>
        ))}

        {/* Cierre de la portada como una frase dentro del flujo y no como un
            recuadro con boton: el recuadro parecia un anuncio pegado al final. */}
        <nav aria-label="Más noticias" class="mx-auto max-w-portal px-4 pt-14 sm:px-6">
          <p class="max-w-3xl text-lg text-pretty text-texto-secundario">
            ¿Buscas algo anterior? Todas las noticias siguen en el <a href="/noticias/" class="font-semibold text-acento-texto underline decoration-1 underline-offset-4 transition-[color] hover:decoration-2">archivo</a>, de
            la más reciente a la más antigua, y también puedes <a href="/buscar/" class="font-semibold text-acento-texto underline decoration-1 underline-offset-4 transition-[color] hover:decoration-2">buscarlas por
            producto o marca</a>.
          </p>
        </nav>
      </>
    ) : (
      <section class="mx-auto max-w-portal px-4 py-10 sm:px-6">
        <p class="rounded-2xl bg-fondo-realzado p-6 text-texto-secundario">
          Todavía no hay noticias publicadas. Vuelve pronto.
        </p>
      </section>
    )
  }
</LayoutBase>
