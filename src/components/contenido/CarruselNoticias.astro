---
import TarjetaNoticia from './TarjetaNoticia.astro';
import type { ArticuloResumen } from '../../lib/api-articulos';

// Fila deslizable de noticias: se mueve con el dedo, la rueda, el teclado (al
// tabular, cada noticia enfocada entra en vista) o las flechas. Sin avance
// automatico: un carrusel que cambia solo no deja leer y es una barrera de
// accesibilidad. En movil asoma la siguiente tarjeta para que se vea que sigue.
interface Props {
  noticias: ArticuloResumen[];
  etiquetaAccesible: string;
  mostrarCategoria?: boolean;
}

const { noticias, etiquetaAccesible, mostrarCategoria = true } = Astro.props;
const claseFlecha =
  'inline-flex size-11 items-center justify-center rounded-full border border-borde bg-superficie text-texto-primario transition-[border-color,color,opacity] duration-200 hover:border-acento-texto hover:text-acento-texto disabled:pointer-events-none disabled:opacity-35';
---

<div data-carrusel>
  <!--
    El relleno interior deja sitio al anillo de foco: el desplazamiento
    horizontal recorta lo que sobresale. En movil la fila llega hasta el borde
    de la pantalla y la tarjeta encaja respetando el margen de la pagina.
  -->
  <ul
    role="list"
    aria-label={etiquetaAccesible}
    data-pista-carrusel
    class="-mx-4 flex scroll-px-4 snap-x snap-mandatory gap-4 overflow-x-auto px-4 py-1.5 [scrollbar-width:none] motion-safe:scroll-smooth sm:-mx-1.5 sm:scroll-px-1.5 sm:gap-6 sm:px-1.5"
  >
    {
      noticias.map((articulo) => (
        <li class="w-[82%] shrink-0 snap-start sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)] xl:w-[calc((100%-4.5rem)/4)]">
          <TarjetaNoticia articulo={articulo} mostrarCategoria={mostrarCategoria} />
        </li>
      ))
    }
  </ul>
  <div class="mt-5 flex justify-end gap-2" data-controles-carrusel hidden>
    <button type="button" class={claseFlecha} data-anterior-carrusel aria-label="Noticias anteriores">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </button>
    <button type="button" class={claseFlecha} data-siguiente-carrusel aria-label="Más noticias">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  // Las flechas solo aparecen si hay algo que desplazar, y cada una se
  // desactiva al llegar a su extremo. Sin JavaScript, la fila se sigue
  // deslizando con el dedo o la rueda: las flechas son una ayuda, no el unico camino.
  const TOLERANCIA_EXTREMO_PX = 2;
  const prefiereMenosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const carrusel of document.querySelectorAll<HTMLElement>('[data-carrusel]')) {
    const pista = carrusel.querySelector<HTMLElement>('[data-pista-carrusel]')!;
    const controles = carrusel.querySelector<HTMLElement>('[data-controles-carrusel]')!;
    const botonAnterior = carrusel.querySelector<HTMLButtonElement>('[data-anterior-carrusel]')!;
    const botonSiguiente = carrusel.querySelector<HTMLButtonElement>('[data-siguiente-carrusel]')!;

    const actualizarControles = (): void => {
      const tieneDesbordamiento = pista.scrollWidth - pista.clientWidth > TOLERANCIA_EXTREMO_PX;
      controles.hidden = !tieneDesbordamiento;
      botonAnterior.disabled = pista.scrollLeft <= TOLERANCIA_EXTREMO_PX;
      botonSiguiente.disabled = pista.scrollLeft + pista.clientWidth >= pista.scrollWidth - TOLERANCIA_EXTREMO_PX;
    };

    // Avanzo casi una pantalla de la fila: el scroll-snap termina de encajar la tarjeta.
    const desplazar = (sentido: number): void => {
      pista.scrollBy({
        left: sentido * pista.clientWidth * 0.9,
        behavior: prefiereMenosMovimiento.matches ? 'auto' : 'smooth',
      });
    };

    botonAnterior.addEventListener('click', () => desplazar(-1));
    botonSiguiente.addEventListener('click', () => desplazar(1));
    pista.addEventListener('scroll', actualizarControles, { passive: true });
    new ResizeObserver(actualizarControles).observe(pista);
    actualizarControles();
  }
</script>
