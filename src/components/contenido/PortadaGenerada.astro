---
import type { CategoriaArticulo, EspecificacionTecnica } from '../../lib/api-articulos';
import { obtenerEtiquetaCategoria } from '../../lib/categorias';

// Portada de datos generada en build-time para los articulos sin imagen de
// prensa oficial: las fotos propias de los medios fuente son de terceros (riesgo
// de derechos), asi que la portada muestra el producto y sus datos clave sobre el
// motivo de su categoria. Es SVG inline y HTML: sin descargas extra, sin tocar
// la CSP y sin penalizar el LCP.
interface Props {
  semilla: string;
  categoria: CategoriaArticulo | null;
  producto: string | null;
  variante?: 'tarjeta' | 'destacada' | 'cabecera' | 'miniatura';
  datosClave?: EspecificacionTecnica[];
}

const { semilla, categoria, producto, variante = 'tarjeta', datosClave = [] } = Astro.props;

// Hash estable del slug: la misma noticia sale siempre igual en cada build,
// pero dos noticias de la misma categoria no son identicas.
function calcularHashEstable(texto: string): number {
  let hash = 2166136261;
  for (const caracter of texto) {
    hash ^= caracter.codePointAt(0) ?? 0;
    hash = Math.imul(hash, 16777619);
  }
  return hash >>> 0;
}

const hash = calcularHashEstable(semilla);
const rotacionMotivo = (hash % 25) - 12;
const desplazamientoMotivo = hash % 40;
const separacionRejilla = 28 + (hash % 3) * 8;

const textoPrincipal = producto ?? obtenerEtiquetaCategoria(categoria);

// En la tarjeta caben dos datos sin tapar el nombre; en las grandes, tres. En
// la miniatura no cabe texto legible: solo el motivo de la categoria.
const esMiniatura = variante === 'miniatura';
const datosVisibles = datosClave.slice(0, variante === 'tarjeta' ? 2 : 3);

const clasesTextoPorVariante = {
  tarjeta: 'text-xl sm:text-2xl',
  destacada: 'text-2xl sm:text-5xl',
  cabecera: 'text-2xl sm:text-5xl',
  miniatura: '',
};

const proporcionPorVariante = {
  tarjeta: 'aspect-video',
  destacada: 'aspect-video',
  // En la cabecera del articulo, panoramica desde tablet: a 16:9 y ancho
  // completo ocupaba media pantalla y empujaba el texto fuera de la vista.
  cabecera: 'aspect-video sm:aspect-[5/2]',
  miniatura: 'aspect-[4/3]',
};
---

<div
  aria-hidden="true"
  class:list={[
    'portada-generada relative isolate w-full overflow-hidden bg-superficie',
    proporcionPorVariante[variante],
  ]}
>
  <svg class="absolute inset-0 h-full w-full" preserveAspectRatio="none">
    <defs>
      <pattern id={`rejilla-${hash}`} width={separacionRejilla} height={separacionRejilla} patternUnits="userSpaceOnUse">
        <path d={`M ${separacionRejilla} 0 L 0 0 0 ${separacionRejilla}`} class="fill-none stroke-borde" stroke-width="0.6" opacity="0.35"></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#rejilla-${hash})`}></rect>
  </svg>

  <!--
    Rotacion y desplazamiento con el atributo transform de SVG, no con un
    style inline: la CSP (style-src 'self') bloquea los atributos style.
  -->
  <svg
    viewBox="0 0 200 200"
    class="motivo-portada absolute -right-[4%] top-1/2 aspect-square h-[92%] -translate-y-1/2 stroke-acento-texto"
    fill="none"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <g transform={`translate(${desplazamientoMotivo - 20} 0) rotate(${rotacionMotivo} 100 100)`}>
    {
      categoria === 'HARDWARE_PC' && (
        <g>
          <rect x="55" y="55" width="90" height="90" rx="8" />
          <rect x="78" y="78" width="44" height="44" rx="4" opacity="0.6" />
          {[70, 90, 110, 130].map((posicionPin) => (
            <>
              <line x1={posicionPin} y1="40" x2={posicionPin} y2="55" />
              <line x1={posicionPin} y1="145" x2={posicionPin} y2="160" />
              <line x1="40" y1={posicionPin} x2="55" y2={posicionPin} />
              <line x1="145" y1={posicionPin} x2="160" y2={posicionPin} />
            </>
          ))}
        </g>
      )
    }
    {
      categoria === 'MOVILES' && (
        <g>
          <rect x="62" y="22" width="76" height="156" rx="16" />
          <rect x="72" y="36" width="56" height="118" rx="6" opacity="0.5" />
          <circle cx="86" cy="48" r="5" />
          <circle cx="100" cy="48" r="5" />
          <line x1="88" y1="166" x2="112" y2="166" />
        </g>
      )
    }
    {
      categoria === 'PERIFERICOS' && (
        <g>
          <rect x="20" y="60" width="160" height="80" rx="10" />
          {[0, 1, 2].map((fila) =>
            [0, 1, 2, 3, 4, 5].map((columna) => (
              <rect x={32 + columna * 23} y={72 + fila * 20} width="16" height="13" rx="3" opacity="0.7" />
            )),
          )}
        </g>
      )
    }
    {
      categoria === 'RENDIMIENTO' && (
        <g>
          <line x1="30" y1="170" x2="175" y2="170" />
          <rect x="45" y="120" width="22" height="50" rx="3" opacity="0.6" />
          <rect x="80" y="90" width="22" height="80" rx="3" opacity="0.75" />
          <rect x="115" y="60" width="22" height="110" rx="3" opacity="0.9" />
          <polyline points="40,125 90,95 125,70 170,35" />
          <polyline points="155,35 170,35 170,50" />
        </g>
      )
    }
    {
      categoria === null && (
        <g>
          <path d="M 55 50 L 100 150 L 145 50" stroke-width="10" />
          <rect x="132" y="128" width="16" height="16" rx="3" class="fill-acento-secundario stroke-none" />
        </g>
      )
    }
    </g>
  </svg>

  {!esMiniatura && (
  <div class="relative flex h-full flex-col justify-end gap-3 p-5 sm:p-6">
    <span
      class:list={[
        'max-w-[62%] font-titulo font-bold leading-tight text-texto-primario break-words hyphens-auto',
        datosVisibles.length > 0 ? 'line-clamp-2' : 'line-clamp-3',
        clasesTextoPorVariante[variante],
      ]}
    >
      {textoPrincipal}
    </span>
    {
      datosVisibles.length > 0 && (
        <dl class="flex max-w-[70%] flex-col gap-1 border-l-2 border-acento-texto pl-3">
          {datosVisibles.map((dato) => (
            <div class="flex min-w-0 gap-2 text-xs sm:text-sm">
              <dt class="shrink-0 font-titulo font-bold uppercase tracking-[0.08em] text-acento-secundario">
                {dato.nombre}
              </dt>
              <dd class="truncate text-texto-primario">{dato.valor}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
  )}
</div>

<style>
  /* El motivo gira un poco al pasar por encima de la tarjeta: la unica
     microinteraccion de la portada. Solo con movimiento permitido. */
  @media (prefers-reduced-motion: no-preference) {
    .motivo-portada {
      transition: rotate 400ms ease-out, opacity 400ms ease-out;
    }
    :global(.group):hover .motivo-portada {
      rotate: 6deg;
    }
  }
  /* Tenue a proposito: es fondo, el nombre del producto tiene que leerse
     encima sin competir con el trazo. */
  .motivo-portada {
    opacity: 0.4;
  }
</style>
